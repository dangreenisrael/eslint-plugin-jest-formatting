{
  "name": "eslint-plugin-jest-formatting",
  "version": "4.0.0",
  "description": "ESLint rules for formatting jest tests",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "jest",
    "format",
    "formatting",
    "padding"
  ],
  "author": "Dan Green-Leipciger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangreenisrael/eslint-plugin-jest-formatting.git"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "docs",
    "AGENTS.md",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "pretty": "yarn prettier '**/*.*'",
    "lint": "yarn build && yarn link-plugin && yarn pretty --check && yarn eslint .",
    "format": "yarn build && yarn link-plugin && yarn pretty --write && yarn eslint --fix .",
    "build": "tsc",
    "prepack": "tsc",
    "test": "yarn build && jest",
    "link-plugin": "yarn link && yarn link eslint-plugin-jest-formatting"
  },
  "peerDependencies": {
    "eslint": "^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jest-formatting": "file:.",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
